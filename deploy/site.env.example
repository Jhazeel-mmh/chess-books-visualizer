# The hosted site's settings (see "Running it as a website" in README.md). Copy to site.env,
# which is git-ignored: it holds the mail password and Paddle's keys.

# The site's domain, and its address.
CBV_DOMAIN=chess.example.com
CBV_PUBLIC_URL=https://chess.example.com
# The public repository with this code (the AGPL asks that the site offer its source).
VITE_SOURCE_URL=https://github.com/you/chess-books-visualizer

# Who runs the site, as the terms, the privacy notice and the copyright policy name them (each on
# one line). The copyright agent is as registered with the US Copyright Office: name, address, phone.
CBV_OPERATOR=Your legal name or company
CBV_OPERATOR_ADDRESS=Street and number, neighbourhood, postal code, city, state, Mexico
CBV_CONTACT_EMAIL=privacy@chess.example.com
CBV_COPYRIGHT_AGENT=Your name, street and number, postal code, city, Mexico, +52 ...

# Mail: sign-up links, password resets, copyright notices.
CBV_SMTP_HOST=smtp.example.com
CBV_SMTP_PORT=587
CBV_SMTP_USER=
CBV_SMTP_PASSWORD=
CBV_MAIL_FROM=Chess Books Visualizer <no-reply@chess.example.com>
CBV_COPYRIGHT_EMAIL=copyright@chess.example.com

# Plus, sold through Paddle (see "Plans and ads" in README.md). Without all four, nothing is sold.
# Start with Paddle's sandbox: CBV_PADDLE_SANDBOX=1 and its sandbox keys.
CBV_PADDLE_API_KEY=
CBV_PADDLE_CLIENT_TOKEN=
CBV_PADDLE_PRICE=
CBV_PADDLE_WEBHOOK_SECRET=
# CBV_PADDLE_SANDBOX=1

# Google AdSense: the publisher id and a display ad unit. Without both, no ads.
CBV_ADSENSE_CLIENT=
CBV_ADSENSE_SLOT=

# Limits (these are the defaults). Change one, then restart the app.
# CBV_MAX_UPLOAD_MB=100
# CBV_MAX_BOOKS=3
# CBV_MAX_STORAGE_MB=300
# CBV_PLUS_MAX_BOOKS=300
# CBV_PLUS_MAX_STORAGE_MB=5000
# CBV_FREE_TRAINER_SESSIONS=7
# CBV_ANALYSIS_MINUTES=20
# CBV_ANALYSIS_MEMORY_MB=4096
# CBV_WORKERS=2
